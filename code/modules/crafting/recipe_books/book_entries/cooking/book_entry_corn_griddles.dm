/datum/book_entry/corn_griddles
	name = "Griddles & Corn"
	category = "Instructions"

/datum/book_entry/corn_griddles/inner_book_html(mob/user)
	return {"
	<div>
	<h2>Griddles & Corn</h2>

	<h3>Griddles</h3>
	Fluffy griddlecakes, fried from eggdough batter:<br>
	<ul>
	<li>On a table, knead an <b>egg</b> into <b>dough</b> to make <b>eggdough</b>.</li>
	<li>Roll the eggdough flat with a <b>rolling pin</b> for <b>griddle dough</b>.</li>
	<li>Fry the griddle dough on a pan for plain <b>griddles</b>.</li>
	<li>Before frying, add <b>lemon</b>, <b>berries</b>, or <b>apple slices</b> to the dough for fruit griddles.</li>
	<li>After frying, top griddles with <b>butter</b>, <b>honey</b>, or <b>chocolate</b> on a table.</li>
	</ul>

	<h3>Corn</h3>
	Maize is ground into cornmeal, then worked into its own dough:<br>
	<ul>
	<li>Grind <b>maize</b> on a millstone to make <b>cornmeal</b>.</li>
	<li>Add <b>water</b> to cornmeal, then knead with your bare hands into <b>unfinished corn dough</b>.</li>
	<li>Work in <b>more cornmeal</b> to finish it as <b>corn dough</b>.</li>
	</ul>

	<h3>Cornbread</h3>
	<ul>
	<li>Bake corn dough as-is for <b>cornbread</b>.</li>
	<li>Add <b>honey</b> to corn dough before baking for <b>honey cornbread</b>.</li>
	</ul>

	<h3>Frybread & Fritters</h3>
	<ul>
	<li>Roll corn dough with a <b>rolling pin</b> for <b>corn flatbread</b> (makes two). Fry for <b>frybread</b>.</li>
	<li>Add <b>cornmeal</b> to corn dough for <b>corn dough balls</b> (makes three). Fry for <b>corn fritters</b>.</li>
	<li>Top frybread with <b>tomato</b> for <b>salsa frybread</b>, or <b>pesto</b> for <b>pesto frybread</b>.</li>
	</ul>

	<h3>Grilled Corn</h3>
	<ul>
	<li>Roast a whole <b>corn cob</b> on a fire or pan for <b>grilled corn</b>.</li>
	<li>Add <b>butter</b> to grilled corn for the buttered version.</li>
	</ul>
	</div>
	"}
