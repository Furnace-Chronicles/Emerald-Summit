/datum/book_entry/pasta
	name = "Pasta"
	category = "Instructions"

/datum/book_entry/pasta/inner_book_html(mob/user)
	return {"
	<div>
	<h2>Pasta</h2>
	Navarno tradition meets Valorian ingenuity. All pasta begins with eggdough.<br><br>

	<h3>Making Eggdough</h3>
	<ul>
	<li>On a table, knead an <b>egg</b> into regular <b>dough</b> to make <b>eggdough</b>.</li>
	</ul>

	<h3>Noodles</h3>
	<ul>
	<li>Slice eggdough into <b>eggdough pieces</b>.</li>
	<li>Roll a piece with a <b>rolling pin</b> to make <b>uncooked noodles</b>.</li>
	<li>Boil the noodles in a pot of water to cook them.</li>
	<li>On a table, add <b>tomato sauce</b> to noodles for <b>spaghetti</b>, or <b>pesto</b> for <b>pesto spaghetti</b>.</li>
	</ul>

	<h3>Lasagna</h3>
	<ul>
	<li>Press two <b>eggdough pieces</b> together on a table for <b>sheet noodles</b>.</li>
	<li>On a table, layer sheet noodles with <b>tomato sauce</b> for red, <b>cheese</b> for white, or <b>pesto</b> for pesto lasagna.</li>
	<li>Red + <b>cheese</b> (or white + <b>tomato sauce</b>) = <b>cheesy lasagna</b>, the richest of all.</li>
	<li>Bake any raw lasagna in an oven to finish it.</li>
	</ul>

	<h3>Tomato Sauce</h3>
	<ul>
	<li>Grind a <b>tomato</b> on a millstone to make <b>tomato sauce</b>.</li>
	</ul>
	</div>
	"}
